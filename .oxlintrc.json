{
  "plugins": ["typescript", "react", "unicorn", "oxc", "vitest", "import"],
  "settings": {
    "react-hooks": { "additionalEffectHooks": "^(useExternalSync|useBeforePaintSync)$" }
  },
  "env": {
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-restricted-globals": [
      "error",
      {
        "name": "Date",
        "message": "Date を使わず Temporal を使う（docs/coding-standards.md「Date を使わない」）"
      }
    ],
    "react/exhaustive-deps": [
      "error",
      { "additionalHooks": "^(useExternalSync|useBeforePaintSync)$" }
    ],
    // 欲しいのは import/no-cycle だけ。import プラグインを入れると suspicious で一緒に出る次の3つは使わない
    "import/no-cycle": "error",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "react/function-component-definition": [
      "error",
      { "namedComponents": "function-declaration", "unnamedComponents": "function-expression" }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useMemo", "useCallback", "memo"],
            "message": "手でメモ化しない。React Compiler に任せる（docs/coding-standards/react.md「手でメモ化しない」）"
          }
        ]
      }
    ],
    "react/no-unstable-nested-components": "error",
    "react/no-array-index-key": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "eqeqeq": "error",
    "unicorn/no-null": "error"
  },
  "overrides": [
    {
      // SDK の型が null を要求する値を渡す。test は SDK・外来の生データ（JSON）を組む所と、DOM API が null を返す・受ける所だけ許す
      "files": [
        "test/fixture/**",
        "test/server/session-driver/**",
        "test/server/report/core/body/draft-component-intake.test.ts",
        "test/server/diary/**",
        "test/server/repository/**",
        "test/server/usage/**",
        "test/server/workflow-setting/**",
        "test/browser/**",
        "test/e2e/**",
        "src/server/session-driver/adapter/sdk/sdk-prompt-stream.ts",
        "src/server/adapter/sdk-structured-query.ts"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      // deps を引数で受けて effect に渡す包み。配列リテラルでないので包みの中では検査できず、呼び手側を additionalHooks で検査する
      "files": [
        "src/browser/hooks/use-external-sync.ts",
        "src/browser/hooks/use-before-paint-sync.ts"
      ],
      "rules": {
        "react/exhaustive-deps": "off"
      }
    },
    {
      // declare module で既存の型へ足す形は interface でないと混ざらない（type だと宣言の重複になる）
      "files": [
        "src/browser/types/customizable-select-global.d.ts",
        "src/browser/types/css-variable.d.ts",
        "test/beads-template-setup.ts",
        "test/architecture/source-table-setup.ts"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      // 外の世界を読む場所を限る（docs/coding-standards.md「外部の入力を読む場所を1つにする」）。
      // `overrides` は規則を丸ごと置き換えるので、許すファイルは下のブロックで「この表から許す分を引いた同じ規則」を書き直す。
      // 引いていない禁止と react の禁止が残る。大きさの上限のため、書き直したブロックの message はこのブロックに任せて省く
      "files": ["src/**"],
      "rules": {
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Date を使わず Temporal を使う（docs/coding-standards.md「Date を使わない」）"
          },
          { "name": "fetch", "message": "fetch を呼ぶのは browser/stores/rpc.ts だけ" }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "process.env を読むのは cli.ts と server/adapter/tsukumo-home.ts だけ（docs/coding-standards/error-input-and-absent-value.md「外部の入力を読む場所を1つにする」）"
          },
          {
            "object": "process",
            "property": "cwd",
            "message": "process.cwd を読むのは cli.ts だけ。以降は引数で配る（docs/coding-standards/error-input-and-absent-value.md「外部の入力を読む場所を1つにする」）"
          },
          {
            "object": "Temporal",
            "property": "Now",
            "message": "Temporal.Now を読むのは server/adapter/local-time.ts（createServerClock と timeZoneId の中だけ。test/architecture/clock.test.ts が縛る）と browser/utils/clock.ts だけ"
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "fetch を呼ぶのは browser/stores/rpc.ts だけ"
          },
          { "object": "window", "property": "fetch" },
          { "object": "self", "property": "fetch" },
          { "object": "global", "property": "fetch" }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback", "memo"],
                "message": "手でメモ化しない。React Compiler に任せる（docs/coding-standards/react.md「手でメモ化しない」）"
              },
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"],
                "message": "生の effect を書かず、src/browser/hooks/ のラッパー（useMountEffect・useEventListener・useExternalSync・useBeforePaintSync など）を使う（docs/coding-standards/react.md「useEffect の代わりに使うもの」）"
              },
              {
                "name": "@anthropic-ai/claude-agent-sdk",
                "message": "SDK を import するのは機能の adapter/ 直下（または adapter/sdk/）と共有の箱 server/adapter/ 直下の sdk- で始まるファイルだけ（docs/architecture/code-placement.md）"
              },
              {
                "name": "@orpc/client",
                "importNames": ["ORPCError"],
                "message": "コマンドの失敗は browser/stores/session.ts の dispatchAwaited が kind に畳んで返す。ORPCError を読むのはそこだけ（docs/coding-standards/error-input-and-absent-value.md「失敗を返す戻り値」）"
              }
            ],
            "patterns": [
              {
                "group": ["node:process", "process"],
                "importNames": ["env", "cwd"],
                "message": "env・cwd を読むのは cli.ts と tsukumo-home.ts だけ（docs/coding-standards/error-input-and-absent-value.md「外部の入力を読む場所を1つにする」）"
              },
              {
                "group": ["node:os", "os"],
                "message": "node:os を import するのは server/adapter/tsukumo-home.ts だけ"
              },
              {
                "group": ["**/tsukumo-home.ts"],
                "importNames": ["tsukumoHomeDir"],
                "message": "~/.tsukumo の下の置き場は tsukumoHomePath(キー) で引く。ホームの根を直に読まない"
              },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true,
                "message": "ネットワークのモジュールを読み込むのは server/view-server/adapter/server.ts だけ"
              }
            ]
          }
        ]
      }
    },
    {
      // 生の effect を許す（包みの実装）。`overrides` は規則を丸ごと置き換えるので、`src/**` のブロックを写して effect の項だけ引く
      "files": [
        "src/browser/hooks/use-mount-effect.ts",
        "src/browser/hooks/use-event-listener.ts",
        "src/browser/hooks/use-external-sync.ts",
        "src/browser/hooks/use-before-paint-sync.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "importNames": ["useMemo", "useCallback", "memo"] },
              { "name": "@anthropic-ai/claude-agent-sdk" },
              { "name": "@orpc/client", "importNames": ["ORPCError"] }
            ],
            "patterns": [
              { "group": ["node:process", "process"], "importNames": ["env", "cwd"] },
              { "group": ["node:os", "os"] },
              { "group": ["**/tsukumo-home.ts"], "importNames": ["tsukumoHomeDir"] },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // ORPCError を許す（コマンドの失敗を kind に畳む1か所）。`src/**` のブロックから ORPCError の項だけ引く
      "files": ["src/browser/stores/session.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "importNames": ["useMemo", "useCallback", "memo"] },
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"]
              },
              { "name": "@anthropic-ai/claude-agent-sdk" }
            ],
            "patterns": [
              { "group": ["node:process", "process"], "importNames": ["env", "cwd"] },
              { "group": ["node:os", "os"] },
              { "group": ["**/tsukumo-home.ts"], "importNames": ["tsukumoHomeDir"] },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // process.env と node:os を許す
      "files": ["src/server/adapter/tsukumo-home.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "process", "property": "cwd" },
          { "object": "Temporal", "property": "Now" },
          { "object": "globalThis", "property": "fetch" },
          { "object": "window", "property": "fetch" },
          { "object": "self", "property": "fetch" },
          { "object": "global", "property": "fetch" }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "importNames": ["useMemo", "useCallback", "memo"] },
              { "name": "@anthropic-ai/claude-agent-sdk" }
            ],
            "patterns": [
              { "group": ["node:process", "process"], "importNames": ["cwd"] },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // SDK を許す
      "files": [
        "src/server/*/adapter/sdk-*.ts",
        "src/server/*/adapter/sdk/sdk-*.ts",
        "src/server/usage/adapter/review/sdk-*.ts",
        "src/server/adapter/sdk-*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "react", "importNames": ["useMemo", "useCallback", "memo"] }],
            "patterns": [
              { "group": ["node:process", "process"], "importNames": ["env", "cwd"] },
              { "group": ["node:os", "os"] },
              { "group": ["**/tsukumo-home.ts"], "importNames": ["tsukumoHomeDir"] },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // http 系を許す
      "files": ["src/server/view-server/adapter/server.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "importNames": ["useMemo", "useCallback", "memo"] },
              { "name": "@anthropic-ai/claude-agent-sdk" }
            ],
            "patterns": [
              { "group": ["node:process", "process"], "importNames": ["env", "cwd"] },
              { "group": ["node:os", "os"] },
              { "group": ["**/tsukumo-home.ts"], "importNames": ["tsukumoHomeDir"] }
            ]
          }
        ]
      }
    },
    {
      // process.env と process.cwd を許す
      "files": ["src/cli.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "Temporal", "property": "Now" },
          { "object": "globalThis", "property": "fetch" },
          { "object": "window", "property": "fetch" },
          { "object": "self", "property": "fetch" },
          { "object": "global", "property": "fetch" }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "importNames": ["useMemo", "useCallback", "memo"] },
              { "name": "@anthropic-ai/claude-agent-sdk" }
            ],
            "patterns": [
              { "group": ["node:os", "os"] },
              { "group": ["**/tsukumo-home.ts"], "importNames": ["tsukumoHomeDir"] },
              {
                "group": ["{node:,}{http,https,http2,net,tls,dgram}"],
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // Temporal.Now を許す
      "files": ["src/browser/utils/clock.ts", "src/server/adapter/local-time.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "process", "property": "env" },
          { "object": "process", "property": "cwd" },
          { "object": "globalThis", "property": "fetch" },
          { "object": "window", "property": "fetch" },
          { "object": "self", "property": "fetch" },
          { "object": "global", "property": "fetch" }
        ]
      }
    },
    {
      // fetch を許す
      "files": ["src/browser/stores/rpc.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Date を使わず Temporal を使う（docs/coding-standards.md「Date を使わない」）"
          }
        ],
        "no-restricted-properties": [
          "error",
          { "object": "process", "property": "env" },
          { "object": "process", "property": "cwd" },
          { "object": "Temporal", "property": "Now" }
        ]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback", "memo"],
                "message": "手でメモ化しない。React Compiler に任せる（docs/coding-standards/react.md「手でメモ化しない」）"
              },
              {
                "name": "node:child_process",
                "importNames": ["execFileSync", "execSync", "spawnSync"],
                "message": "テストでは子プロセスを同期で待たない。test/fixture/subprocess.ts を使う（docs/coding-standards.md「テスト」節）"
              },
              {
                "name": "child_process",
                "importNames": ["execFileSync", "execSync", "spawnSync"],
                "message": "テストでは子プロセスを同期で待たない。test/fixture/subprocess.ts を使う（docs/coding-standards.md「テスト」節）"
              }
            ]
          }
        ],
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
        // `useTempDir` などの `use` で始まるテスト用の補助を、React の外の `describe` 直下で呼ぶため
        "react/rules-of-hooks": "off",
        // describe の中の it ごとの小さな補助関数を、使う it の近くに置いて読めるようにする。
        // 巻き上げると describe の外へ離れて、どのテストの前提かが読めなくなる
        "unicorn/consistent-function-scoping": "off",
        // 判別の値を先に expect で確かめ、型を絞る if の中で残りの欄を確かめる形がある。
        // as を使わずに型を絞るために、期待が if の中に入る
        "vitest/no-conditional-expect": "off"
      }
    },
    {
      "files": ["test/e2e/**"],
      "rules": {
        // E2E の確かめは画面の撮影の比較（settleAndMatch）が持ち、it の直下に expect が現れない
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "src/shared/**",
        "src/server/core/**",
        "src/server/*/core/**",
        "src/browser/**/domain/**",
        "src/browser/utils/**"
      ],
      "rules": {
        "typescript/no-restricted-types": [
          "error",
          {
            "types": {
              "null": "null は自前の型に出さない（docs/coding-standards/error-input-and-absent-value.md「null は自前の型に出さない」）"
            }
          }
        ]
      }
    },
    {
      // 外の型が null を要求する口。React の RefObject<X | null> と lezer の SyntaxNode.parent（SyntaxNode | null）
      "files": [
        "src/browser/domain/reveal/use-report-reveal.ts",
        "src/browser/components/page/conversation/components/dispatch/domain/markdown-newline-continuation.ts"
      ],
      "rules": {
        "typescript/no-restricted-types": "off"
      }
    }
  ]
}
