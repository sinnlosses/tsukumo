      }
    },
    {
      "afterMs": 1200,
      "event": {
        "kind": "utterance",
        "text": "自動判定が止めた操作のお願いを出す場面（架空）。答えるとお願いが消える。\n"
      }
    },
    {
      "afterMs": 1300,
      "event": {
        "kind": "turn-finished",
        "outcome": {
          "kind": "completed"
        }
      }
    }
  ]
