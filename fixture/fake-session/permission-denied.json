      "afterMs": 100,
      "event": {
        "kind": "permission-denied",
        "denial": {
          "toolUseId": "fake-denied-1",
          "toolName": "Bash",
          "reason": "Classifier unavailable"
        }
      }
    },
    {
      "afterMs": 200,
      "event": {
        "kind": "speech",
