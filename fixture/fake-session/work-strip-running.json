        "current": 0,
        "finishedInGroup": [],
        "phaseSummary": ""
      }
    },
    {
      "afterMs": 200,
      "event": {
        "kind": "tool-started",
        "toolUseId": "fake-strip-1",
        "name": "Read",
        "input": {
          "file_path": "/tmp/dummy/metric.ts"
        }
      }
    },
    {
      "afterMs": 8500,
      "event": {
        "kind": "tool-finished",
