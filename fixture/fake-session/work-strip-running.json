{
  "name": "work-strip-running",
  "steps": [
    {
      "afterMs": 0,
      "event": {
        "kind": "request",
        "text": "集計の関数とスクリプトを足したい（架空の依頼）",
        "images": []
      }
    },
    {
      "afterMs": 100,
      "event": {
        "kind": "work-plan",
