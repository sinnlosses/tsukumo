{
  "name": "report-pair-heading",
  "steps": [
    {
      "afterMs": 0,
      "event": {
        "kind": "request",
        "text": "再試行の設定を見直して、前後の違いを見たい（架空の依頼）",
        "images": []
      }
    },
    {
      "afterMs": 1500,
      "event": {
        "kind": "report",
        "toolUseId": "fake-pair-heading-1",
        "components": [
          {
            "id": "root",
            "component": "Report",
            "conclusion": ["架空の結論: 再試行の上限を 3 回から 5 回に増やし、待ちを短くした。"],
            "checks": [],
            "children": ["s1"],
            "closing": { "text": "並べたよ！", "expression": "proud" }
          },
          {
            "id": "s1",
            "component": "Section",
            "heading": "架空の再試行の設定",
            "children": ["pair", "ttable"]
          },
          {
            "id": "pair",
            "component": "Compare",
            "title": "再試行の設定",
            "relation": "before-after",
            "sides": [
              {
                "kind": "points",
                "heading": "今",
                "points": ["上限は 3 回", "待ちは 200ms"]
              },
              {
                "kind": "points",
                "heading": "見直したあと",
                "points": ["上限は 5 回", "待ちは 100ms"]
              }
            ],
            "fold": "",
            "aside": ""
          },
          {
            "id": "ttable",
            "component": "Table",
            "title": "設定の値の変化",
            "columns": ["名前", "前から後"],
            "rows": [
              ["上限（回）", { "from": "3", "to": "5" }],
              ["待ち（ms）", { "from": "200", "to": "100" }],
              ["方式", { "from": "固定", "to": "指数" }]
            ]
          }
        ]
      }
    },
    {
      "afterMs": 1550,
      "event": {
        "kind": "tool-finished",
        "toolUseId": "fake-pair-heading-1",
        "content": "ok",
        "isError": false
      }
    },
    { "afterMs": 2300, "event": { "kind": "turn-finished", "outcome": { "kind": "completed" } } }
  ]
}
