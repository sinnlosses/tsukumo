{
  "name": "report",
  "steps": [
    {
      "afterMs": 100,
      "event": {
        "kind": "partial-utterance",
        "text": "## 疑似セッションの"
      }
    },
    {
      "afterMs": 150,
      "event": {
        "kind": "partial-utterance",
        "text": "レポート\n\n"
      }
    },
    {
      "afterMs": 200,
      "event": {
        "kind": "partial-utterance",
        "text": "これは架空の本文で、実物の会話ではない。\n"
      }
    },
    {
      "afterMs": 300,
      "event": {
        "kind": "tool-started",
        "toolUseId": "fake-tool-1",
        "name": "Read",
        "input": {
          "file_path": "/tmp/dummy/notes.md"
        }
      }
    },
    {
      "afterMs": 700,
      "event": {
        "kind": "tool-finished",
        "toolUseId": "fake-tool-1",
        "content": "ダミーの読み取り結果（3行）",
        "isError": false
      }
    },
    {
      "afterMs": 720,
      "event": {
        "kind": "tool-started",
        "toolUseId": "fake-tool-2",
        "name": "Bash",
        "input": {
          "command": "dummy-command --check /tmp/dummy/nowhere"
        }
      }
    },
    {
      "afterMs": 760,
      "event": {
        "kind": "tool-finished",
        "toolUseId": "fake-tool-2",
        "content": "dummy-command: /tmp/dummy/nowhere が無い（疑似セッションの作り物のエラー出力）\n終了コード 1",
        "isError": true
      }
    },
    {
      "afterMs": 800,
      "event": {
        "kind": "speech",
        "text": "読み終わったよ。中身はダミーだけどね。",
        "expression": "proud"
      }
    },
    {
      "afterMs": 900,
      "event": {
        "kind": "utterance",
        "text": "## 疑似セッションのレポート\n\nこれは架空の本文で、実物の会話ではない。\n\n- 段2 の配信の経路を確かめるための疑似セッション\n- 表・コードなどの記法は段6で unified に置き換わる\n\n<div class=\"note note-warn\">注意：この疑似セッションの中身はすべて架空で、実物の会話ではない。</div>\n"
      }
    },
    {
      "afterMs": 1000,
      "event": {
        "kind": "turn-finished",
        "outcome": {
          "kind": "completed"
        }
      }
    }
  ]
}
