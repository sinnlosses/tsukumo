{
  "name": "current-work-failed",
  "steps": [
    {
      "afterMs": 0,
      "event": {
        "kind": "request",
        "text": "帯の「失敗」を確かめたい（架空の依頼）",
        "images": []
      }
    },
    {
      "afterMs": 100,
      "event": {
        "kind": "speech",
        "text": "確かめてみるね。",
        "expression": "default"
      }
    },
    {
      "afterMs": 200,
      "event": {
        "kind": "tool-started",
        "toolUseId": "fake-tool-current-work-failed-1",
        "name": "Bash",
        "input": {
          "command": "dummy-command --check /tmp/dummy/nowhere"
        }
      }
    },
    {
      "afterMs": 400,
      "event": {
        "kind": "tool-finished",
        "toolUseId": "fake-tool-current-work-failed-1",
        "content": "dummy-command: /tmp/dummy/nowhere が無い（疑似セッションの作り物のエラー出力）\n終了コード 1",
        "isError": true
      }
    },
    {
      "afterMs": 500,
      "event": {
        "kind": "speech",
        "text": "だめだった。中身はダミーだけどね。",
        "expression": "sad"
      }
    },
    {
      "afterMs": 600,
      "event": {
        "kind": "utterance",
        "text": "## 帯の「失敗」を確かめる場面\n\nこれは架空の本文で、実物の会話ではない。**自分の `request` を持つ**ので `TSUKUMO_FAKE_SCENE` で直接起こしても、ターンが終わったあとの「前の依頼での手順」に失敗した1件が残る（`scripts/capture/capture-catalog.ts` の `current-work-failed`）。\n"
      }
    },
    {
      "afterMs": 700,
      "event": {
        "kind": "turn-finished",
        "outcome": {
          "kind": "completed"
        }
      }
    }
  ]
}
