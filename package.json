{
  "name": "tsukumo",
  "version": "0.0.0",
  "private": true,
  "description": "キャラクターと一緒に楽しく仕事をするためのターミナル環境",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
