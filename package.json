{
  "name": "tsukumo",
  "version": "0.0.0",
  "private": true,
  "description": "キャラクターと一緒に楽しく仕事をするためのターミナル環境",
  "bin": {
    "tsukumo": "bin/tsukumo"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun run build && TSUKUMO_WATCH_UI=1 bun run src/cli.ts",
    "build": "bun run scripts/build-ui.ts",
    "grid": "bun run scripts/open-room-grid.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "bun test --isolate --path-ignore-patterns='test/e2e/**'",
    "test:e2e": "bun run build && bun test --isolate --timeout=60000 test/e2e/",
    "test:e2e:update": "E2E_UPDATE=1 bun run test:e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/tanstack-query": "^1.15.4",
    "@tanstack/react-query": "^5.103.2",
    "chart.js": "4.5.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "mermaid": "12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.50.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
