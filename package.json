{
  "name": "tsukumo",
  "version": "0.0.0",
  "private": true,
  "description": "キャラクターと一緒に楽しく仕事をするためのターミナル環境",
  "bin": {
    "tsukumo": "bin/tsukumo"
  },
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts",
    "prepare": "pnpm run build",
    "dev": "pnpm run build && node src/cli.ts --dev",
    "build": "pnpm run css-types && node scripts/build-ui.ts",
    "css-types": "hcm 'src/**/*.module.css' --outDir dist/css-module-type --logLevel silent",
    "grid": "node scripts/open-room-grid.ts",
    "typecheck": "pnpm run css-types && tsc --noEmit && tsc --noEmit -p tsconfig.storybook.json",
    "lint": "oxlint src test scripts story .storybook vite.config.ts",
    "lint:fix": "oxlint src test scripts story .storybook vite.config.ts --fix",
    "format": "node scripts/write-document-index.ts && oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:e2e:update": "node scripts/e2e-update.ts",
    "check": "nice node scripts/check.ts",
    "ship": "node scripts/ship.ts",
    "storybook": "storybook dev --port 6006 --no-open"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/tanstack-query": "^1.15.4",
    "@tanstack/react-query": "^5.103.2",
    "chart.js": "4.5.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.50.0",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "happy-css-modules": "^5.0.2",
    "happy-dom": "^20.14.5",
    "oxc-transform-react": "~0.145.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0"
}
