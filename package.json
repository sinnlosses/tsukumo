{
  "name": "tsukumo",
  "version": "0.0.0",
  "private": true,
  "description": "キャラクターと一緒に楽しく仕事をするためのターミナル環境",
  "bin": {
    "tsukumo": "bin/tsukumo"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "bun test --isolate",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test --isolate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
