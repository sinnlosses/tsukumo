#!/bin/sh
# PATH の node は mise.toml の版とは限らないので、リポジトリの根の mise.toml が指す node で起こす。
# pnpm のグローバル導入が作るシムはこのシバン行を読んで処理系を決めるので、node のシバンに戻さない。
set -eu

resolve_target() {
  target=$1
  while [ -L "$target" ]; do
    dir=$(CDPATH= cd -P -- "$(dirname "$target")" && pwd)
    link=$(readlink "$target")
    case "$link" in
      /*) target=$link ;;
      *) target="$dir/$link" ;;
    esac
  done
  dir=$(CDPATH= cd -P -- "$(dirname "$target")" && pwd)
  printf '%s/%s\n' "$dir" "$(basename "$target")"
}

self=$(resolve_target "$0")
root=$(CDPATH= cd -P -- "$(dirname "$self")/.." && pwd)

node=""
if command -v mise >/dev/null 2>&1; then
  node=$(mise -C "$root" which node 2>/dev/null) || node=""
fi
if [ -z "$node" ]; then
  node=$(command -v node 2>/dev/null) || node=""
fi
if [ -z "$node" ]; then
  echo "tsukumo: node が見つからない（mise install を済ませたか確かめてください）" >&2
  exit 1
fi

# package.json の engines.node（>=<数>）を下限にする。.ts を直に実行するので、古い node では
# src/ の中に案内を書けず、構文に依らないここで止める。読めないときは比べずに通す。
have=$("$node" -p "process.versions.node" 2>/dev/null) || have=""
need=$("$node" -p "require('$root/package.json').engines.node" 2>/dev/null) || need=""
have_major=${have%%.*}
need_major=${need#>=}
need_major=${need_major%%.*}
case "$have_major" in '' | *[!0-9]*) have_major="" ;; esac
case "$need_major" in '' | *[!0-9]*) need_major="" ;; esac
if [ -n "$have_major" ] && [ -n "$need_major" ] && [ "$have_major" -lt "$need_major" ]; then
  echo "tsukumo: node $have が古い（$need が要る。mise install を済ませたか確かめてください）" >&2
  exit 1
fi

exec "$node" "$root/src/cli.ts" "$@"
