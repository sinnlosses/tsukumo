# 依存
node_modules/

# macOS
.DS_Store

.idea/

# ブラウザ側の成果物（pnpm run build で作る。2.6MB の生成物を履歴に入れない）
dist/

# キャラクター素材（権利のあるものを公開リポジトリに入れないため）
characters/local/

# Claude Code のセッションが作るロック（設定ファイルだけを履歴に入れる）
.claude/scheduled_tasks.lock

# vitest のアーティファクトディレクトリ
.vitest/

# E2E で落ちた it の Playwright の trace（test/e2e/output/<シナリオ>/trace.zip）
/test/e2e/output/

# Stryker の走っている間だけできる元ファイルの控え（stryker.config.mjs）
/.stryker-tmp/

# pnpm run check が同じ木での打ち直しのために残す、通った段の控え（書きかけの一時ファイルも）
/.check-record.json*
